# D-GRAG example environment configuration
# Copy this file to `.env` and replace placeholder values before running:
#   docker compose up --build
# or:
#   docker run --env-file .env btp-dgrag:latest

# ------------------------------
# Runtime mode
# ------------------------------
# Supported values:
# - webhook     : FastAPI GitHub webhook service
# - cli         : CLI-oriented container usage
# - llm         : LLM-backed review mode
# - full-review : alias for llm/full review flows
DGRAG_MODE=webhook

# ------------------------------
# Network / service config
# ------------------------------
DGRAG_HOST=0.0.0.0
DGRAG_PORT=8000
DGRAG_CACHE_DIR=/app/.cache/dgrag

# ------------------------------
# GitHub integration
# ------------------------------
# Required for all GitHub-backed review flows.
GITHUB_TOKEN=ghp_replace_me

# Required in webhook mode for HMAC signature validation.
GITHUB_WEBHOOK_SECRET=replace_me_with_a_long_random_secret

# Name of the environment variable containing the GitHub token.
GITHUB_TOKEN_ENV_VAR=GITHUB_TOKEN

# ------------------------------
# Retrieval / pipeline defaults
# ------------------------------
DGRAG_DEPTH_K=2
DGRAG_DEPTH_M=3

# ------------------------------
# Optional Redis cache
# ------------------------------
# Enable only if you want to use the Redis sidecar from docker-compose.
REDIS_ENABLED=false
REDIS_URL=redis://redis:6379/0

# ------------------------------
# Optional LLM provider config
# ------------------------------
# Only required for LLM-backed / full-review flows.
OPENAI_API_KEY=sk-replace_me

# Optional model selection / backend knobs
OPENAI_MODEL=gpt-4o-mini
DGRAG_MODEL_LABEL=retrieval-only

# ------------------------------
# FastAPI / webhook app behavior
# ------------------------------
LOG_LEVEL=INFO

# ------------------------------
# Notes
# ------------------------------
# Minimum required variables by mode:
#
# webhook:
#   - GITHUB_TOKEN
#   - GITHUB_WEBHOOK_SECRET
#
# cli:
#   - GITHUB_TOKEN
#
# llm / full-review:
#   - GITHUB_TOKEN
#   - OPENAI_API_KEY
